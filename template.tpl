    mockData.subscriberState = 'active';

    mock('sendHttpRequest', (url, options, body) => {
      assertThat(url).isEqualTo('https://api.kit.com/v4/subscribers');
      assertThat(options.method).isEqualTo('POST');

      const parsedBody = JSON.parse(body);
      assertThat(parsedBody.email_address).isEqualTo('subscriber@example.com');
      assertThat(parsedBody.first_name).isEqualTo('Alice');
      assertThat(parsedBody.state).isEqualTo('active');
